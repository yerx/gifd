{
  "name": "@gifd/builder",
  "version": "0.0.0-pre",
  "private": true,
  "description": "Gifd app-builder agent: customize Gifd's apps from chat via draft sandboxes",
  "type": "module",
  "exports": {
    ".": {
      "default": "./index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@openclaw/plugin-sdk": "workspace:*",
    "openclaw": "workspace:*"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.16"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ]
  }
}
